{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
         {
            "type": "node",
            "request": "launch",
            "name": "Debug TypeScript (ts-node)",
            "program": "${workspaceFolder}/servernode/node_modules/ts-node/dist/bin.js",
            "args": [
                "${workspaceFolder}/servernode/src/index.ts"
            ],
            "cwd": "${workspaceFolder}/servernode",
            "protocol": "inspector",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "Attach",
            "port": 3000,
            "request": "attach",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node"
        }
    ]
}