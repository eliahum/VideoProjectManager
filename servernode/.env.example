PORT=3000
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/dbname?appName=Cluster0
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-strong-random-string
JWT_EXPIRY=24h

# Google Drive Backup Configuration
ENABLE_GOOGLE_DRIVE_OAUTH_BACKUP=true
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-google-oauth-refresh-token
GOOGLE_OAUTH_FOLDER_ID=your-google-drive-folder-id
